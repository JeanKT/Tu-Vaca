@using TuVaca.Comun
@model List<TuVaca.Models.Contactos.ContactoRecibidoItem>
@{
    ViewData["Title"] = "Mensajes recibidos";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="tv-titulo h3 mb-0">Mensajes recibidos</h1>
            <p class="text-muted small mb-0">Compradores interesados en tus publicaciones.</p>
        </div>
        <a asp-controller="Publicaciones" asp-action="Index" class="btn btn-tv-outline">Mis publicaciones</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card tv-card"><div class="card-body text-center py-5 text-muted">Todavía no has recibido mensajes.</div></div>
    }
    else
    {
        <div class="vstack gap-3">
            @foreach (var m in Model)
            {
                <div class="card tv-card">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between gap-2">
                            <p class="fw-semibold mb-1">@m.CompradorNombre</p>
                            <span class="text-muted small">@Formatos.FechaHora(m.FechaContacto)</span>
                        </div>
                        <p class="tv-dato mb-2">
                            ✉ <a href="mailto:@m.CompradorCorreo">@m.CompradorCorreo</a>
                            @if (!string.IsNullOrWhiteSpace(m.CompradorTelefono))
                            {
                                <span> · 📞 @m.CompradorTelefono</span>
                            }
                        </p>
                        <p class="mb-2">@m.Mensaje</p>
                        <p class="text-muted small mb-0">Sobre: @m.Publicacion</p>
                    </div>
                </div>
            }
        </div>
    }
</div>
