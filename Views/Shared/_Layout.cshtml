<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string titulo ? $"{titulo} - Tu Vaca" : "Tu Vaca")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tuvaca.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="tv-body">
    @* La barra de navegación es la misma en todas las páginas. Una vista la oculta con ViewData["OcultarBarra"] = true *@
    @if (ViewData["OcultarBarra"] is not true)
    {
        <partial name="_Navbar" />
    }

    @* Mensajes de confirmación o error (TempData["Exito"] y TempData["Error"]) *@
    <partial name="_Mensajes" />

    @RenderBody()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
