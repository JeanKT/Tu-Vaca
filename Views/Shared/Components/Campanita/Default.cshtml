@using TuVaca.Comun
@model TuVaca.ViewComponents.CampanitaModelo
@{
    var paginaActual = Context.Request.Path + Context.Request.QueryString;
}

<div class="dropdown">
    <button type="button" class="btn tv-campanita-boton position-relative px-2"
            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
            aria-label="Notificaciones: @Model.NoLeidas sin leer">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
        </svg>
        @if (Model.NoLeidas > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                @(Model.NoLeidas > 9 ? "9+" : Model.NoLeidas.ToString())
            </span>
        }
    </button>

    <div class="dropdown-menu dropdown-menu-end tv-campanita-menu p-0 shadow">
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
            <strong>Notificaciones</strong>
            @if (Model.NoLeidas > 0)
            {
                <form asp-controller="Notificaciones" asp-action="MarcarTodas" method="post" class="m-0">
                    <input type="hidden" name="returnUrl" value="@paginaActual" />
                    <button type="submit" class="btn btn-link btn-sm p-0">Marcar todas como leídas</button>
                </form>
            }
        </div>

        @if (Model.Ultimas.Count == 0)
        {
            <p class="text-muted small px-3 py-3 mb-0">No tienes notificaciones.</p>
        }

        @foreach (var notificacion in Model.Ultimas)
        {
            <a class="dropdown-item tv-notificacion py-2 @(notificacion.Leida ? "" : "no-leida")"
               asp-controller="Notificaciones" asp-action="Abrir" asp-route-id="@notificacion.Id">
                <div class="small fw-semibold">@notificacion.Tipo</div>
                <div class="small">@notificacion.Mensaje</div>
                <div class="text-muted small">@Formatos.FechaHora(notificacion.Fecha)</div>
            </a>
        }

        <div class="text-center py-2">
            <a asp-controller="Notificaciones" asp-action="Index" class="small">Ver todas</a>
        </div>
    </div>
</div>
