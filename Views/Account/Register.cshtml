@using TuVaca.Comun
@using TuVaca.Seguridad
@model TuVaca.Models.Cuentas.RegistroViewModel
@{
    ViewData["Title"] = "Crear cuenta";
    ViewData["OcultarBarra"] = true; // como en el prototipo: esta pantalla solo muestra el logo
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">
            <div class="card tv-card shadow-sm">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <img src="~/images/tuvagalogo.jpeg" alt="Tu Vaca" class="tv-logo" />
                        <h1 class="tv-titulo h3 mt-3 mb-1">Crear cuenta nueva</h1>
                        <p class="text-muted small mb-0">Todos los campos son obligatorios, menos el teléfono.</p>
                    </div>

                    <form asp-controller="Account" asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="NombreCompleto" class="form-label"></label>
                            <input asp-for="NombreCompleto" class="form-control" autocomplete="name" />
                            <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NumeroDocumento" class="form-label"></label>
                                <input asp-for="NumeroDocumento" class="form-control" inputmode="numeric" />
                                <span asp-validation-for="NumeroDocumento" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Telefono" class="form-label"></label>
                                <input asp-for="Telefono" class="form-control" inputmode="tel" autocomplete="tel" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label"></label>
                            <input asp-for="Correo" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Rol" class="form-label"></label>
                            <select asp-for="Rol" class="form-select">
                                <option value="">Selecciona…</option>
                                <option value="@Catalogos.RolProductor">Productor / Vendedor</option>
                                <option value="@Catalogos.RolComprador">Comprador / Visitante</option>
                            </select>
                            <span asp-validation-for="Rol" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Contrasena" class="form-label"></label>
                                <input asp-for="Contrasena" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="Contrasena" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmarContrasena" class="form-label"></label>
                                <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                            </div>
                        </div>
                        <p class="form-text mt-0 mb-4">@Contrasenas.MensajeRegla</p>

                        <div class="d-flex gap-2">
                            @* FA-1-CU01: cancelar pide confirmación y no guarda nada *@
                            <a asp-controller="Home" asp-action="Index" class="btn btn-tv-outline w-50"
                               onclick="return confirm('¿Deseas cancelar el registro?');">Cancelar</a>
                            <button type="submit" class="btn btn-tv w-50">Crear cuenta</button>
                        </div>
                    </form>

                    <hr class="my-4" />
                    <p class="text-center small mb-0">
                        <a asp-controller="Account" asp-action="Login">← Volver al inicio de sesión</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
