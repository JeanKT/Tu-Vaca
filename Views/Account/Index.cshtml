@{
    ViewData["Title"] = "Acceso a la plataforma";
}

<div class="container mt-5 mb-5">
    <h2 class="mb-4">Acceso a la plataforma</h2>

    <div class="row g-4">
        <!-- COLUMNA IZQUIERDA: INICIAR SESIÓN -->
        <div class="col-lg-5">
            <div class="card tv-card p-4 bg-white mb-4">
                <h4 class="card-title mb-4">Iniciar sesión</h4>

                <form>
                    <div class="mb-3">
                        <label class="form-label">Correo o Cédula</label>
                        <input type="text" class="form-control" value="ramiro.ospina@finca.co" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <input type="password" class="form-control" value=".........." />
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4" style="font-size: 0.85rem;">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="mantenerSesion" checked>
                            <label class="form-check-label text-muted" for="mantenerSesion">Mantener sesión activa</label>
                        </div>
                        <a href="#" class="text-decoration-none" style="color: #2b7053;">¿Olvidó su contraseña?</a>
                    </div>

                    <button type="submit" class="btn btn-green w-100 py-2 mb-3">Ingresar</button>
                </form>

                <!-- Alerta de Bloqueo -->
                <div class="alert-custom p-3 text-sm" style="font-size: 0.9rem;">
                    <div class="fw-bold text-dark mb-1">Intento fallido registrado</div>
                    Credenciales inválidas 1 de 5. Tras 5 intentos la cuenta se bloquea 15 minutos.
                </div>
            </div>
        </div>

        <!-- COLUMNA DERECHA: REGISTRO Y SESIONES -->
        <div class="col-lg-7">

            <!-- Tarjeta Crear Cuenta -->
            <div class="card tv-card p-4 bg-white mb-4">
                <h4 class="card-title mb-4">Crear cuenta nueva</h4>

                <form>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Nombre Completo</label>
                            <input type="text" class="form-control" value="Luz Marina Cardona" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cédula</label>
                            <input type="text" class="form-control" value="43.118.902" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Municipio</label>
                            <select class="form-select text-muted">
                                <option>Sonsón, Antioquia</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Teléfono</label>
                            <input type="text" class="form-control" value="+57 310 442 7781" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Rol</label>
                        <select class="form-select text-muted">
                            <option>Productor / Vendedor</option>
                        </select>
                    </div>

                    <div class="row g-3 mb-1">
                        <div class="col-md-6">
                            <label class="form-label">Contraseña</label>
                            <input type="password" class="form-control" value=".........." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Confirmar Contraseña</label>
                            <input type="password" class="form-control" value=".........." />
                        </div>
                    </div>
                    <div class="text-muted mb-4" style="font-size: 0.75rem;">Mínimo 8 caracteres</div>

                    <div class="d-flex align-items-center gap-3">
                        <button type="button" class="btn btn-brown px-4 py-2">Registrarme</button>
                        <span class="text-muted" style="font-size: 0.85rem;">Acepto los términos y la política de datos.</span>
                    </div>
                </form>
            </div>

            <!-- Tarjeta Sesiones Activas -->
            <div class="card tv-card p-4 bg-white">
                <h4 class="card-title mb-4">Sesión activa</h4>

                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0" style="font-size: 0.85rem;">
                        <thead>
                            <tr style="border-bottom: 1px solid #eee;">
                                <th class="text-muted text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Dispositivo</th>
                                <th class="text-muted text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Ubicación</th>
                                <th class="text-muted text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Último Acceso</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td class="py-3">Chrome · Windows</td>
                                <td>Sonsón, ANT</td>
                                <td>Hoy 06:12 a.m.</td>
                                <td class="text-end">
                                    <span class="badge rounded-pill" style="background-color: #d1ebd8; color: #1e6631; font-weight: 500; padding: 6px 12px;">Actual</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="py-3">Android · Motorola</td>
                                <td>La Unión, ANT</td>
                                <td>Ayer 08:40 p.m.</td>
                                <td class="text-end">
                                    <button class="btn btn-sm rounded-pill" style="background-color: #fbe6e8; color: #c43241; border: 1px solid transparent; font-size: 0.75rem; font-weight: 500; padding: 4px 12px;">Cerrar sesión</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div> 