@{
    ViewData["Title"] = "Enlace no válido";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card tv-card shadow-sm text-center">
                <div class="card-body p-4">
                    <img src="~/images/tuvagalogo.jpeg" alt="Tu Vaca" class="tv-logo" />
                    @* FE-2-CU23: el enlace venció o ya se usó *@
                    <h1 class="tv-titulo h4 mt-3">Este enlace ya no es válido. Solicita uno nuevo</h1>
                    <p class="text-muted small">Los enlaces vencen a los 30 minutos y solo se pueden usar una vez.</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-tv-outline">Iniciar sesión</a>
                        <a asp-controller="RecuperarContrasena" asp-action="Solicitar" class="btn btn-tv">Solicitar un enlace nuevo</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
