@model TuVaca.Models.Cuentas.SolicitarRecuperacionViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card tv-card shadow-sm">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <img src="~/images/tuvagalogo.jpeg" alt="Tu Vaca" class="tv-logo" />
                        <h1 class="tv-titulo h3 mt-3 mb-1">Recuperar contraseña</h1>
                        <p class="text-muted small mb-0">
                            Escribe el correo con el que te registraste y te enviaremos un enlace
                            para crear una contraseña nueva.
                        </p>
                    </div>

                    <form asp-controller="RecuperarContrasena" asp-action="Solicitar" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Correo" class="form-label"></label>
                            <input asp-for="Correo" class="form-control" autocomplete="email" autofocus />
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            @* FA-1-CU23: cancelar vuelve al inicio de sesión sin cambiar nada *@
                            <a asp-controller="Account" asp-action="Login" class="btn btn-tv-outline w-50">Cancelar</a>
                            <button type="submit" class="btn btn-tv w-50">Enviar enlace de recuperación</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
