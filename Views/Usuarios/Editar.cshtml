@using TuVaca.Comun
@model TuVaca.Models.Administracion.EditarUsuarioViewModel
@{
    ViewData["Title"] = "Editar usuario";
    var auditoria = (List<TuVaca.Models.Administracion.AuditoriaItem>)ViewBag.Auditoria;
}

<div class="container py-4" style="max-width:820px">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">← Gestión de usuarios</a>
    <h1 class="tv-titulo h3 mb-3">Editar datos de usuario</h1>

    <form asp-action="Editar" method="post" class="card tv-card mb-4">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="UsuarioId" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Correo</label>
                    <input value="@Model.Correo" class="form-control" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Documento</label>
                    <input value="@Model.NumeroDocumento" class="form-control" disabled />
                </div>
                <div class="col-12">
                    <label asp-for="NombreCompleto" class="form-label"></label>
                    <input asp-for="NombreCompleto" class="form-control" />
                    <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Telefono" class="form-label"></label>
                    <input asp-for="Telefono" class="form-control" />
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Direccion" class="form-label"></label>
                    <input asp-for="Direccion" class="form-control" />
                    <span asp-validation-for="Direccion" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="card-footer bg-transparent d-flex gap-2 justify-content-end">
            @* FA-1-CU10 *@
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-tv" onclick="return confirm('¿Guardar los cambios?');">Guardar</button>
        </div>
    </form>

    @* RN-5-CU10: historial de acciones del administrador sobre este usuario *@
    <h2 class="h5">Historial de cambios (auditoría)</h2>
    @if (auditoria.Count == 0)
    {
        <p class="text-muted">Sin acciones registradas.</p>
    }
    else
    {
        <div class="card tv-card table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light"><tr><th>Fecha</th><th>Administrador</th><th>Acción</th><th>Detalle</th></tr></thead>
                <tbody>
                    @foreach (var a in auditoria)
                    {
                        <tr><td>@Formatos.FechaHora(a.Fecha)</td><td>@a.Administrador</td><td>@a.Accion</td><td>@a.Detalle</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
