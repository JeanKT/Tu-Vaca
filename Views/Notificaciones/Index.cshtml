@using TuVaca.Comun
@model List<TuVaca.Servicios.NotificacionVista>
@{
    ViewData["Title"] = "Mis notificaciones";
    var esDesarrollo = ViewData["EsDesarrollo"] is true;
    var hayNoLeidas = Model.Any(n => !n.Leida);
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="tv-titulo h3 mb-0">Mis notificaciones</h1>
        <div class="d-flex flex-wrap gap-2">
            @if (esDesarrollo)
            {
                <form asp-controller="Notificaciones" asp-action="Prueba" method="post" class="m-0">
                    <button type="submit" class="btn btn-sm btn-tv-outline">Crear notificación de prueba</button>
                </form>
            }
            @if (hayNoLeidas)
            {
                <form asp-controller="Notificaciones" asp-action="MarcarTodas" method="post" class="m-0">
                    <button type="submit" class="btn btn-sm btn-tv">Marcar todas como leídas</button>
                </form>
            }
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card tv-card">
            <div class="card-body text-center text-muted py-5">No tienes notificaciones todavía.</div>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var notificacion in Model)
            {
                <a asp-controller="Notificaciones" asp-action="Abrir" asp-route-id="@notificacion.Id"
                   class="list-group-item list-group-item-action tv-notificacion @(notificacion.Leida ? "" : "no-leida")">
                    <div class="d-flex justify-content-between gap-2">
                        <strong class="small">@notificacion.Tipo</strong>
                        <span class="text-muted small">@Formatos.FechaHora(notificacion.Fecha)</span>
                    </div>
                    <div>@notificacion.Mensaje</div>
                    @if (!notificacion.Leida)
                    {
                        <span class="badge text-bg-success mt-1">Nueva</span>
                    }
                </a>
            }
        </div>
    }
</div>
