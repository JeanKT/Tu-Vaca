@using TuVaca.Comun
@model TuVaca.Models.Produccion.RegistrarProduccionViewModel
@{
    ViewData["Title"] = "Registrar producción de leche";
}

<div class="container py-4" style="max-width:560px">
    <h1 class="tv-titulo h3 mb-1">Registrar producción de leche</h1>
    <p class="text-muted mb-4">Vaca <strong>@Model.VacaIdentificacion</strong></p>

    <form asp-action="Registrar" method="post" class="card tv-card">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="VacaId" />
            <input type="hidden" asp-for="VacaIdentificacion" />

            @if (Model.YaExiste)
            {
                @* FA-2-CU11 *@
                <div class="alert alert-warning">
                    Ya existe un registro para esta fecha (@Model.CantidadAnterior?.ToString("0.##") L). ¿Deseas actualizarlo?
                </div>
                <input type="hidden" asp-for="ConfirmarActualizacion" value="true" />
            }

            <div class="mb-3">
                <label asp-for="Fecha" class="form-label">Fecha *</label>
                <input asp-for="Fecha" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" readonly="@Model.YaExiste" />
                <span asp-validation-for="Fecha" class="text-danger small"></span>
            </div>
            <div class="mb-0">
                <label asp-for="CantidadLitros" class="form-label">Cantidad (litros) *</label>
                <input asp-for="CantidadLitros" type="number" step="0.1" min="0.1" class="form-control" />
                <span asp-validation-for="CantidadLitros" class="text-danger small"></span>
            </div>
        </div>
        <div class="card-footer bg-transparent d-flex gap-2 justify-content-end">
            <a asp-action="Historial" asp-route-id="@Model.VacaId" class="btn btn-outline-secondary">@(Model.YaExiste ? "No" : "Cancelar")</a>
            <button type="submit" class="btn btn-tv">@(Model.YaExiste ? "Sí, actualizar" : "Guardar")</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
