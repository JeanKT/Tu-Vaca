@using TuVaca.Comun
@model TuVaca.Models.Produccion.HistorialProduccionViewModel
@{
    ViewData["Title"] = "Historial de producción";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="tv-titulo h3 mb-0">Historial de producción de leche</h1>
            <p class="text-muted mb-0">Vaca <strong>@Model.VacaIdentificacion</strong> · @Model.VacaRaza</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Vacas" asp-action="Index" class="btn btn-outline-secondary">← Mis vacas</a>
            @if (Model.VacaViva)
            {
                <a asp-action="Registrar" asp-route-vacaId="@Model.VacaId" class="btn btn-tv">+ Registrar producción</a>
            }
        </div>
    </div>

    @* FA-3-CU11: rango de fechas *@
    <form asp-action="Historial" asp-route-id="@Model.VacaId" method="get" class="card tv-card mb-3">
        <div class="card-body row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold" for="desde">Desde</label>
                <input id="desde" name="desde" type="date" class="form-control" value="@Model.Desde.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold" for="hasta">Hasta</label>
                <input id="hasta" name="hasta" type="date" class="form-control" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-tv flex-fill">Consultar</button>
                <a asp-action="Historial" asp-route-id="@Model.VacaId" asp-route-desde="@DateTime.Today.AddDays(-6).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">7 días</a>
                <a asp-action="Historial" asp-route-id="@Model.VacaId" class="btn btn-outline-secondary">30 días</a>
            </div>
        </div>
    </form>

    @* RN-6: total y promedio del periodo *@
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3"><div class="card tv-card"><div class="card-body"><p class="text-muted small mb-0">Total del periodo</p><p class="h4 mb-0">@Model.Total.ToString("0.##") L</p></div></div></div>
        <div class="col-6 col-md-3"><div class="card tv-card"><div class="card-body"><p class="text-muted small mb-0">Promedio diario</p><p class="h4 mb-0">@Model.Promedio.ToString("0.##") L</p></div></div></div>
        <div class="col-6 col-md-3"><div class="card tv-card"><div class="card-body"><p class="text-muted small mb-0">Días registrados</p><p class="h4 mb-0">@Model.Registros.Count</p></div></div></div>
    </div>

    @if (Model.Registros.Count == 0)
    {
        @* FE-3-CU11 *@
        <div class="card tv-card"><div class="card-body text-center py-5 text-muted">Esta vaca aún no tiene registros de producción de leche en este periodo.</div></div>
    }
    else
    {
        <div class="card tv-card table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Fecha</th><th class="text-end">Litros</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.Registros)
                    {
                        <tr>
                            <td>@Formatos.Fecha(r.Fecha)</td>
                            <td class="text-end">@r.CantidadLitros.ToString("0.##")</td>
                            <td class="text-end">
                                <form asp-action="Eliminar" asp-route-id="@r.ProduccionId" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Deseas eliminar este registro? Esta acción no se puede deshacer.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
