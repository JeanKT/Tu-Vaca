@using TuVaca.Comun
@using TuVaca.Seguridad
@{
    ViewData["Title"] = "Inicio";
    var autenticado = User.EstaAutenticado();
    var esProductor = User.ObtenerRol() == Catalogos.RolProductor;
    var urlMisVacas = Url.Action("Index", "Vacas"); // existe desde el CU-02
}

<div class="container py-5">
    <div class="card tv-card shadow-sm text-center mx-auto tv-inicio">
        <div class="card-body px-4 py-5">
            <img src="~/images/tuvagalogo.jpeg" alt="Tu Vaca" class="tv-logo-grande mb-4" />
            <h1 class="tv-serif tv-inicio-titulo mb-3">Gestión ganadera y ganadería digital</h1>
            <p class="text-muted mx-auto mb-4 tv-inicio-texto">
                Administra tu hato, controla la producción de leche y conecta directamente con
                compradores y vendedores en nuestro Marketplace.
            </p>

            @if (!autenticado)
            {
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-tv px-4 py-2 fw-semibold">Iniciar Sesión</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-tv-marron px-4 py-2 fw-semibold">Registrarse</a>
                </div>
            }
            else
            {
                <p class="fs-5 fw-semibold mb-3">¡Hola, @User.ObtenerNombre()!</p>
                if (esProductor && urlMisVacas != null)
                {
                    <a href="@urlMisVacas" class="btn btn-tv px-4 py-2 fw-semibold">Ir a Mi hato</a>
                }
            }
        </div>
    </div>

    <div class="row g-4 mt-1 mx-auto tv-inicio">
        <div class="col-md-4">
            <div class="card tv-card h-100">
                <div class="card-body p-4">
                    <div class="tv-icono-tarjeta mb-3" aria-hidden="true">📊</div>
                    <h2 class="tv-serif h5 fw-bold">Mi Hato</h2>
                    <p class="text-muted small mb-0">
                        Registro individual de bovinos, genealogía, estado de salud y trazabilidad
                        completa de cada ejemplar.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card tv-card h-100">
                <div class="card-body p-4">
                    <div class="tv-icono-tarjeta mb-3" aria-hidden="true">🛒</div>
                    <h2 class="tv-serif h5 fw-bold">Marketplace</h2>
                    <p class="text-muted small mb-0">
                        Compra y venta directa entre ganaderos sin intermediarios, con publicaciones
                        verificadas.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card tv-card h-100">
                <div class="card-body p-4">
                    <div class="tv-icono-tarjeta mb-3" aria-hidden="true">🥛</div>
                    <h2 class="tv-serif h5 fw-bold">Producción</h2>
                    <p class="text-muted small mb-0">
                        Monitoreo y estadísticas de pesajes de leche, rendimiento diario y
                        proyecciones del predio.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
