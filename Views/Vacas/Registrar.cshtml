@model TuVaca.Models.Hato.RegistrarVacaViewModel
@{
    ViewData["Title"] = "Registrar vaca";
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card tv-card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="tv-titulo h3 mb-1">Registrar vaca</h1>
                    <p class="text-muted small mb-4">Los campos con * son obligatorios.</p>

                    <form asp-controller="Vacas" asp-action="Registrar" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Identificacion" class="form-label">Identificación (arete, chip o registro) *</label>
                                <input asp-for="Identificacion" class="form-control" placeholder="Ej: CO-000123" />
                                <span asp-validation-for="Identificacion" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Raza" class="form-label">Raza *</label>
                                <input asp-for="Raza" class="form-control" list="razas" placeholder="Escribe o escoge" />
                                <datalist id="razas">
                                    <option value="Holstein"></option>
                                    <option value="Jersey"></option>
                                    <option value="Normando"></option>
                                    <option value="Pardo Suizo"></option>
                                    <option value="Gyr"></option>
                                    <option value="Girolando"></option>
                                    <option value="Brahman"></option>
                                    <option value="Cebú"></option>
                                    <option value="Simmental"></option>
                                    <option value="Angus"></option>
                                    <option value="Romosinuano"></option>
                                    <option value="Blanco Orejinegro (BON)"></option>
                                    <option value="Costeño con Cuernos"></option>
                                    <option value="Criolla"></option>
                                    <option value="Cruzada / Mestiza"></option>
                                </datalist>
                                <span asp-validation-for="Raza" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Sexo" class="form-label">Sexo *</label>
                                <select asp-for="Sexo" class="form-select">
                                    <option value="">Selecciona…</option>
                                    <option value="Hembra">Hembra</option>
                                    <option value="Macho">Macho</option>
                                </select>
                                <span asp-validation-for="Sexo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="FechaNacimiento" class="form-label">Fecha de nacimiento *</label>
                                <input asp-for="FechaNacimiento" class="form-control" max="@hoy" />
                                <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="EdadMeses" class="form-label">o edad aproximada (meses)</label>
                                <input asp-for="EdadMeses" class="form-control" min="1" max="360" />
                                <span asp-validation-for="EdadMeses" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Peso" class="form-label">Peso (kg) *</label>
                                <input asp-for="Peso" type="number" step="0.1" min="0.1" class="form-control" />
                                <span asp-validation-for="Peso" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="DepartamentoId" class="form-label">Departamento de origen</label>
                                <select asp-for="DepartamentoId" asp-items="ViewBag.Departamentos" class="form-select"
                                        data-municipios="MunicipioOrigenId" data-url="@Url.Action("Municipios", "Ubicaciones")">
                                    <option value="">Opcional…</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="MunicipioOrigenId" class="form-label">Municipio de origen</label>
                                <select asp-for="MunicipioOrigenId" class="form-select"
                                        data-seleccionado="@Model.MunicipioOrigenId" disabled>
                                    <option value="">Selecciona primero el departamento</option>
                                </select>
                                <span asp-validation-for="MunicipioOrigenId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Foto" class="form-label">Fotografía (opcional)</label>
                            <input asp-for="Foto" class="form-control" accept="image/jpeg,image/png,image/webp" />
                            <div class="form-text">JPG, PNG o WEBP de máximo 2 MB. Si no subes una, se muestra una imagen genérica.</div>
                            <span asp-validation-for="Foto" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            @* FA-1-CU02: cancelar pide confirmación y vuelve a "Mis vacas" sin guardar *@
                            <a asp-controller="Vacas" asp-action="Index" class="btn btn-tv-outline w-50"
                               onclick="return confirm('¿Deseas cancelar el registro de la vaca?');">Cancelar</a>
                            <button type="submit" class="btn btn-tv w-50">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ubicaciones.js" asp-append-version="true"></script>
}
